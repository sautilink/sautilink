{
  "name": "SautiLink",
  "short_name": "SautiLink",
  "lang": "en",
  "id": "/",
  "start_url": "/home",
  "scope": "/",
  "scope_extensions": [
    { "type": "origin", "origin": "https://sautilink.com" },
    { "type": "origin", "origin": "https://www.sautilink.com" },
    { "type": "origin", "origin": "https://router.sautilink.com" },
    { "type": "origin", "origin": "https://cloudengine.sautilink.com" },
    { "type": "origin", "origin": "https://www.router.sautilink.com" },
    { "type": "origin", "origin": "https://wifi.sautilink.com" },
    { "type": "origin", "origin": "https://business.sautilink.com" },
    { "type": "origin", "origin": "https://tz.sautilink.com" },
    { "type": "origin", "origin": "https://mobile.sautilink.com" }
  ],
  "display": "standalone",
  "launch_handler": { "client_mode": "navigate-existing" },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{
        "name": "media",
        "accept": ["image/jpeg", ".jpg", ".jpeg", "image/png", ".png", "image/webp", ".webp", "video/mp4", ".mp4"]
      }]
    }
  },
  "orientation": "any",
  "background_color": "#0b0c0f",
  "theme_color": "#0b0c0f",
  "description": "A privacy-first social network built in Tanzania for the world.",
  "description_localized": {
    "sw": "Mtandao wa kijamii unaotanguliza faragha, uliobuniwa Tanzania kwa ajili ya dunia.",
    "fr": "Un réseau social qui privilégie la confidentialité, créé en Tanzanie pour le monde."
  },
  "categories": ["social", "communication"],
  "shortcuts": [
    { "name": "Home", "short_name": "Home", "url": "/home", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "short_name": "Messages", "url": "/messages", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notifications", "short_name": "Alerts", "url": "/notifications", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Create Post", "short_name": "Post", "url": "/compose", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/favicon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
