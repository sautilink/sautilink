{
  "name": "sautilink-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:app && npm run build:preview",
    "build:app": "esbuild src/app.js --bundle --minify --format=esm --target=es2022 --outfile=app/assets/app.js",
    "build:preview": "vite build --config vite.preview.config.js && vite build --config vite.identity.config.js && vite build --config vite.profiles.config.js && vite build --config vite.share-stream.config.js && vite build --config vite.media.config.js && vite build --config vite.conversations.config.js && vite build --config vite.trust-safety.config.js && node scripts/stage-preview-site.mjs",
    "dev:preview": "vite --config vite.preview.config.js",
    "dev:identity": "vite --config vite.identity.config.js",
    "serve:preview": "vite preview --config vite.preview.config.js",
    "serve:identity": "vite preview --config vite.identity.config.js",
    "serve:profiles": "vite preview --config vite.profiles.config.js",
    "serve:stream": "vite preview --config vite.share-stream.config.js",
    "serve:media": "vite preview --config vite.media.config.js",
    "serve:conversations": "vite preview --config vite.conversations.config.js",
    "serve:trust-safety": "vite preview --config vite.trust-safety.config.js",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy:preview:dry": "wrangler deploy --env preview --dry-run",
    "deploy:identity:dry": "wrangler deploy --env identity --dry-run",
    "deploy:profiles:dry": "wrangler deploy --env profiles --dry-run",
    "deploy:stream:dry": "wrangler deploy --env stream --dry-run",
    "deploy:media:dry": "wrangler deploy --env media --dry-run",
    "deploy:conversations:dry": "wrangler deploy --env conversations --dry-run",
    "deploy:trust-safety:dry": "wrangler deploy --env trust-safety --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "0.28.2",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  }
}
