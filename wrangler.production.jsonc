{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sautilink-social-production",
  "compatibility_date": "2026-08-17",
  "main": "./dist-production-worker/src/asset-router.js",
  "routes": [
    {
      "pattern": "sautilink.com/app",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/app/*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/api/*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/login*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/signup*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/home*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/discover*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/saved*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/appeals*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/moderation*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/settings*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/notifications*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/messages*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/sautify*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/u/*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "sautilink.com/post/*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/app",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/app/*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/api/*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/login*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/signup*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/home*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/discover*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/saved*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/appeals*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/moderation*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/settings*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/notifications*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/messages*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/sautify*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/u/*",
      "zone_name": "sautilink.com"
    },
    {
      "pattern": "www.sautilink.com/post/*",
      "zone_name": "sautilink.com"
    }
  ],
  "assets": {
    "directory": "./dist-production-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PROFILE_MEDIA",
      "bucket_name": "sautilink-media-production"
    },
    {
      "binding": "SAUTI_MEDIA",
      "bucket_name": "sautilink-media-production"
    }
  ],
  "ratelimits": [
    {
      "name": "SAUTI_CREATE_LIMITER",
      "namespace_id": "3201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SAUTI_DELETE_LIMITER",
      "namespace_id": "3202",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "SAUTI_MEDIA_BEGIN_LIMITER",
      "namespace_id": "3203",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SOCIAL_FOLLOW_LIMITER",
      "namespace_id": "3204",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SOCIAL_LIKE_LIMITER",
      "namespace_id": "3205",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SOCIAL_COMMENT_LIMITER",
      "namespace_id": "3206",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "SOCIAL_COMMENT_DELETE_LIMITER",
      "namespace_id": "3207",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SOCIAL_REPOST_LIMITER",
      "namespace_id": "3208",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SAFETY_REPORT_LIMITER",
      "namespace_id": "3209",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SAFETY_BLOCK_LIMITER",
      "namespace_id": "3210",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "SAFETY_DELETION_LIMITER",
      "namespace_id": "3211",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SAFETY_MUTE_LIMITER",
      "namespace_id": "3212",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SAFETY_APPEAL_LIMITER",
      "namespace_id": "3213",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "MODERATION_ACTION_LIMITER",
      "namespace_id": "3214",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "ACCOUNT_CONTROL_LIMITER",
      "namespace_id": "3215",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
