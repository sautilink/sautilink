{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sautilink",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./"
  },
  "env": {
    "preview": {
      "name": "sautilink-app-shell-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-preview-site"
      }
    },
    "identity": {
      "name": "sautilink-identity-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-preview-site"
      }
    },
    "profiles": {
      "name": "sautilink-profiles-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-preview-site"
      }
    },
    "stream": {
      "name": "sautilink-share-stream-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-preview-site"
      }
    },
    "media": {
      "name": "sautilink-r2-media-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-preview-site"
      }
    },
    "conversations": {
      "name": "sautilink-conversations-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-preview-site"
      }
    },
    "trust-safety": {
      "name": "sautilink-trust-safety-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist-preview-site"
      }
    }
  }
}
